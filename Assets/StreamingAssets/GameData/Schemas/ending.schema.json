{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Ending Data",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the ending, e.g. ENDING_TRUTH_SEEKER"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "required": [
    "id",
    "name",
    "description"
  ],
  "additionalProperties": false
}
