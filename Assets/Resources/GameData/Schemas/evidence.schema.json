{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Evidence Data",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the evidence, e.g. EVIDENCE_CHAPEL"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "reliability": {
      "type": "string",
      "enum": ["TRUE", "FALSE", "UNKNOWN", "HIGH", "LOW"]
    }
  },
  "required": [
    "id",
    "text"
  ],
  "additionalProperties": false
}
