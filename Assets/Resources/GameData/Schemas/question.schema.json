{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Question Data",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the question, e.g. QUESTION_CHAPEL"
    },
    "text": {
      "type": "string"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "description": "Simple string condition, e.g. visitedChapel == true"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "text",
    "responses"
  ],
  "additionalProperties": false
}
